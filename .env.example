# Copy to .env and fill in. Never commit .env.

# --- Database (Postgres + pgvector from docker compose) ---
DATABASE_URL=postgresql+psycopg://reels:reels@localhost:5432/reels
# Integration tests only. Must point to a database whose name ends in "_test".
TEST_DATABASE_URL=postgresql+psycopg://reels:reels@localhost:5432/reels_test

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# api_id / api_hash from https://my.telegram.org (needed by the local Bot API server)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Local Bot API server (docker compose service telegram-bot-api)
TELEGRAM_API_URL=http://localhost:8081
# File paths reported by the Bot API server live inside its container.
# They are mapped to the host by replacing this prefix:
TELEGRAM_FILES_CONTAINER_PATH=/var/lib/telegram-bot-api
TELEGRAM_FILES_HOST_PATH=./data/telegram-bot-api
# Chat that receives errors and admin notices (numeric chat id)
ADMIN_CHAT_ID=

# --- OpenAI ---
OPENAI_API_KEY=
# Model names are configuration, never hard-coded. Fill in models available to your account.
OPENAI_MODEL_TEXT=
OPENAI_MODEL_VISION=
OPENAI_MODEL_EMBED=

# --- Pexels (B-roll, from Etappe 6) ---
PEXELS_API_KEY=

# --- Runtime ---
DATA_DIR=./data
FONTS_DIR=./assets/fonts
# FFmpeg must be built with libass. Absolute paths work too.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# whisperx (CPU, int8) or mlx (Apple GPU). The default is decided by the benchmark in Etappe 1.
TRANSCRIBE_ENGINE=whisperx
# Models are downloaded from Hugging Face on first use.
WHISPERX_MODEL=large-v3-turbo
WHISPERX_BATCH_SIZE=8
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
LOG_LEVEL=INFO
# json (one JSON object per line) or text (one key=value line per event)
LOG_FORMAT=text
